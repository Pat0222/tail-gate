[Unit]
Description=Puppy Play Time — Peripheral Controller (buttons, OLED, buzzer)
After=sysinit.target

[Service]
Type=simple
User=pat0222
WorkingDirectory=/home/pat0222/dog-door
ExecStart=/home/pat0222/dog-door/venv/bin/python peripheral_controller.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
