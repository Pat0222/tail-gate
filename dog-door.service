[Unit]
Description=Tail Gate RG — Dog Door Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pat0222
WorkingDirectory=/home/pat0222/dog-door
ExecStart=/home/pat0222/dog-door/venv/bin/python door_controller.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
